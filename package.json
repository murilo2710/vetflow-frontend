{
  "name": "vetflow-frontend",
  "version": "1.0.0",
  "description": "VetFlow - Microfrontend React (shell + microfrontends agenda e prontuario) que consome apenas o BFF",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "build:agenda": "node build.mjs agenda",
    "build:prontuario": "node build.mjs prontuario",
    "start": "node build.mjs && node serve.mjs",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "author": "Bernardo Vieira, Murilo Regnier",
  "license": "MIT",
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
